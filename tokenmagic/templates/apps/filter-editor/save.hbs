<section class="flexcol" style="gap: 5px;">

    <div class="form-group">    
        <label>{{localize "TMFX.app.savePreset.name.label"}}</label>
        <div class="form-fields">
            <input type="text" name="name" value="{{name}}"/>
        </div>
        <p class="hint">{{localize "TMFX.app.savePreset.name.hint"}}</p>
    </div>

    {{#if macro}}
    <label>{{localize "DOCUMENT.Macro"}}:</label>
    <textarea style="width: 100%; height: 280px;" readonly>{{macro}}</textarea>
    {{else if (eq documentName "Region")}}
    <fieldset>
        <legend>{{localize "DOCUMENT.Region"}}</legend>
        <div class="form-group">
            <label>{{localize "TMFX.app.editPreset.option.defaultColor"}}</label>
            <div class="form-fields">
                <color-picker name="defaultColor" value="{{defaultColor}}"></color-picker>
            </div>
        </div>
        <div class="form-group">    
            <label>{{localize "TMFX.app.editPreset.option.defaultOpacity"}}</label>
            <div class="form-fields">
                <range-picker name="defaultOpacity" value="{{defaultOpacity}}" min="0" max="1" step="0.01"></range-picker>
            </div>
        </div>
    </fieldset>
    {{/if}}

    <div class="form-group">    
        <label>{{localize "TMFX.app.savePreset.filterRandomized.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="filterRandomized" {{checked filterRandomized}}/>
        </div>
        <p class="hint">{{localize "TMFX.app.savePreset.filterRandomized.hint"}}</p>
    </div>

    <div class="form-group">    
        <label>{{localize "TMFX.app.savePreset.filterAnimated.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="filterAnimated" {{checked filterAnimated}}/>
        </div>
        <p class="hint">{{localize "TMFX.app.savePreset.filterAnimated.hint"}}</p>
    </div>

    {{#if displayAutoDestroy}}
    <div class="form-group">    
        <label>{{localize "TMFX.app.savePreset.autoDestroy.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="autoDestroy" {{checked autoDestroy}}/>
        </div>
        <p class="hint">{{localize "TMFX.app.savePreset.autoDestroy.hint"}}</p>
    </div>
    {{/if}}
</section>