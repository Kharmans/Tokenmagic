<section class="flexcol" style="gap: 5px;">

    <div class="form-group">    
        <label>{{localize "DOCUMENT.FIELDS.name.label"}}</label>
        <div class="form-fields">
            <input type="text" name="name" value="{{name}}"/>
        </div>
    </div>

    <div class="form-group">    
        <label>{{localize "TMFX.app.editPreset.option.library"}}</label>
        <div class="form-fields">
            <input type="text" value="{{library}}" disabled/>
        </div>
    </div>

    {{#if defaultColor}}
    <div class="form-group">    
        <label>{{localize "TMFX.app.editPreset.option.defaultColor"}}</label>
        <div class="form-fields">
            <color-picker name="defaultColor" value="{{defaultColor}}"></color-picker>
        </div>
    </div>
    <div class="form-group">    
        <label>{{localize "TMFX.app.editPreset.option.defaultOpacity"}}</label>
        <div class="form-fields">
            <range-picker name="defaultOpacity" value="{{defaultOpacity}}" min="0" max="1" step="0.01"></range-picker>
        </div>
    </div>
    {{/if}}

    <label>Params:</label>
    <textarea style="width: 100%; height: 280px;" readonly>{{params}}</textarea>
</section>